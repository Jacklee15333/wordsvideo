    "stem": "He is ______ to win the race.",
    "opts": [
     "likely",
     "probable",
     "possible",
     "like"
    ],
    "ans": "A",
    "why": "sb. is likely to do 某人很可能做某事；probable、possible 不这样用。",
    "kd": "用法"
   },

  "qs": [
   {
    "type": "听力",
    "ask": "听录音，回答问题：说话人和姐姐有什么不同？",
    "listen": "Unlike my sister, I don't like sweets.",
    "zh": "",
    "stem": "",
    "opts": [
     "我喜欢吃甜食",
     "我不喜欢吃甜食",
     "我比姐姐高",
     "我和姐姐一样"
    ],
    "ans": "B",
    "why": "unlike 不像……，说明“我”和姐姐不一样。",
    "kd": ""
   },
   {
    "type": "单项选择",
    "ask": "选出最恰当的一项。",
    "listen": "",
    "zh": "",
    "stem": "She sings ______ a bird; her voice is beautiful.",
    "opts": [
     "unlike",
     "alike",
     "like",
     "likely"
    ],
    "ans": "C",
    "why": "像鸟一样唱歌，用介词 like。",
    "kd": "词性转换"
   },
   {
    "type": "选词填空",
    "ask": "从 unlike、dislike 中选一个，用适当形式填空。",
    "listen": "",
    "zh": "",
    "stem": "I ______ getting up early on weekends.",
    "opts": [],
    "ans": "dislike",
    "why": "不喜欢做某事用动词 dislike；unlike 是“不像”。",
    "kd": "易混"
   },

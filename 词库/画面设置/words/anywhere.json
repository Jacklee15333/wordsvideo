 "kaodian": {
  "rows": [
   [
    "意思",
    "adv. 任何地方；（否定、疑问）哪儿都（不）"
   ],
   [
    "用法",
    "not anywhere = nowhere"
   ],
   [
    "短语",
    "anywhere near（否定）远远不：not anywhere near enough 远远不够"
   ],
   [
    "区别",
    "肯定句说“某处”用 somewhere；否定、疑问用 anywhere"
   ]
  ]
 },

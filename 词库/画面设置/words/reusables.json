    "ask": "听录音，回答问题：商店现在卖什么？",
    "listen": "The shop now sells reusables like cloth bags.",
    "zh": "",
    "stem": "",
    "opts": [
     "一次性用品",
     "二手车",
     "玩具",
     "可重复使用的东西"
    ],
    "ans": "D",
    "why": "reusables 可重复使用的物品。",
    "kd": ""
   },
   {
    "type": "单项选择",
    "ask": "选出最恰当的一项。",
    "listen": "",
    "zh": "",
    "stem": "Cloth bags and glass jars are good ______.",
    "opts": [
     "reuse",
     "reusable",
     "reusing",
     "reusables"
    ],
    "ans": "D",
    "why": "复数主语，表语用名词复数 reusables。",
    "kd": ""
   },
   {
    "type": "选词填空",
    "ask": "从 reuse、reusable 中选一个，用适当形式填空。",
    "listen": "",
    "zh": "",
    "stem": "This bottle is ______; don't throw it away.",
    "opts": [],
    "ans": "reusable",
    "why": "be 后面要形容词 reusable。",
    "kd": "词性转换"
   },
   {
    "type": "适当形式填空",
    "ask": "用所给单词的适当形式填空。",
    "listen": "",
    "zh": "",
    "stem": "We ______ these jars again and again. (reusables)",
    "opts": [],
    "ans": "reuse",
    "why": "主语 we，用动词原形 reuse。",
    "kd": "词性转换"
   },
   {
    "type": "改错",
    "ask": "句子里有一处错误，找出来并改正。",
    "listen": "",
    "zh": "",
    "stem": "These reusables is cheap.",
    "opts": [],
    "ans": "is → are",
    "why": "主语 these reusables 是复数，用 are。",
    "kd": ""
   },
   {
    "type": "完成句子",
    "ask": "根据中文完成句子，每空一词。",
    "listen": "",
    "zh": "用可重复使用的杯子代替纸杯。",
    "stem": "Use a reusable cup ______ of a paper cup.",
    "opts": [],
    "ans": "instead",
    "why": "instead of 代替。",
    "kd": "短语"
   },
   {
    "type": "单项选择",
    "ask": "选出最恰当的一项。",
    "listen": "",
    "zh": "",
    "stem": "Which of these is a reusable thing?",
    "opts": [
     "a paper cup",
     "a plastic straw",
     "a tissue",
     "a cloth bag"
    ],
    "ans": "D",
    "why": "布袋可以一次次用；纸杯、吸管、纸巾都是一次性的。",
    "kd": "用法"
   }
  ]
 }

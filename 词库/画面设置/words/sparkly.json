    "ans": "C",
    "why": "sparkly 闪闪发光的、亮晶晶的。",
    "kd": ""
   },
   {
    "type": "单项选择",
    "ask": "选出最恰当的一项。",
    "listen": "",
    "zh": "",
    "stem": "Her new shoes are the ______ in the shop.",
    "opts": [
     "sparklier",
     "sparkly",
     "sparkliest",
     "sparklest"
    ],
    "ans": "C",
    "why": "the … in the shop 用最高级，y 变 i 加 est。",
    "kd": "变形"
   },
   {
    "type": "适当形式填空",
    "ask": "用所给单词的适当形式填空。",
    "listen": "",
    "zh": "",
    "stem": "This star looks ______ than that one. (sparkly)",
    "opts": [],
    "ans": "sparklier",
    "why": "than 前用比较级，y 变 i 加 er。",
    "kd": "变形"
   },

    "why": "Thankfully 幸好。",
    "kd": ""
   },
   {
    "type": "单项选择",
    "ask": "选出最恰当的一项。",
    "listen": "",
    "zh": "",
    "stem": "______, we got to the station on time.",
    "opts": [
     "Thankful",
     "Thankfully",
     "Thank",
     "Thanks"

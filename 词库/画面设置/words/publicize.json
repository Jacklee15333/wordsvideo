    "listen": "",
    "zh": "",
    "stem": "The event was ______ on the Internet. (publicize)",
    "opts": [],
    "ans": "publicized",
    "why": "was 加过去分词表示被动，publicize 去 e 加 d。",
    "kd": "变形"
   },
